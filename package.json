{
  "name": "ridgewell-colorado",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "predev": "node scripts/prepare-static.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/prepare-static.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "audit": "node scripts/audit-build.mjs"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "@types/node": "^24.0.0",
    "@opentelemetry/api": "^1.9.0"
  }
}
